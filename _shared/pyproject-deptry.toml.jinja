[tool.deptry]
# 依存はプロジェクト本体を含む。DEP002（未使用依存）は使い始めるまで出るので無視する。
# DEP004 pytest: pytest を import するのは tests/（fixture / raises /
# MonkeyPatch）だけであり、正当な dev 専用利用。mcp_server のテストも同じ
# ルールに触れるため、エンジン横断で無視する。
# DEP004 httpx: 同じく tests/ だけが import する（web_api の TestClient 代替と
# line bot のテストが ASGITransport / AsyncClient を使う）。dev 専用利用。
# DEP002 の web_api 系名前は web_api（またはその派生 effective）でのみ依存に現れる
# ので、その名前を他の構成に混入させない。残りの共有名（logging 系・rich 等）は
# どの pkg を持つプロジェクトでも deps に現れ得るため無条件に置く。
per_rule_ignores = "DEP002=httpx|pendulum|pydantic|rich|structlog|loguru|picologging|typer{% if web_api or include_web_api %}|alembic|asgi-correlation-id|asyncpg|fastapi|pydantic-settings|slowapi|sqlalchemy|uvicorn{% endif %}{% if prometheus_effective %}|prometheus-client{% endif %}{% if ds_stack %}|duckdb|ipykernel|jupyterlab|marimo|matplotlib|nbclient|nbstripout|openai|plotly|polars|pyarrow|seaborn|wandb{% endif %}{% if kaggle %}|hydra-core|lightgbm|omegaconf|optuna|pandas|pyyaml|torch|torchvision|xgboost{% endif %}{% if ctf_effective %}|pwntools|z3-solver{% endif %}{% if scraping_scrapy_effective %}|scrapy{% endif %}{% if scraping_memorious_effective %}|memorious4{% endif %}{% if scraping_playwright_effective %}|playwright{% endif %}{% if cloud_provider == 'aws' %}|boto3|botocore|boto3-stubs{% endif %}{% if cloud_provider == 'gcp' %}|google-cloud-storage{% endif %}{% if cloud_provider == 'azure' %}|azure-identity{% endif %},DEP003={{ package_name }}|requests{% if mcp_effective %}|starlette{% endif %}{% if micropython_pkg %},DEP001=mpremote|micropython|machine|board_config{% endif %}{% if mcp_effective %},DEP001=starlette{% endif %},DEP004=httpx|pytest"
# tasks.py/duties.py: root-level dev script, not project source -- deptry
# would otherwise flag invoke/duty as DEP004 (dev-only dep imported by "source")
exclude = ["tools", ".venv", ".pixi", ".task", "build", "dist"{% if micropython_pkg %}, "firmware"{% endif %}{% if task_runner_effective == 'invoke' %}, "tasks.py"{% endif %}{% if task_runner_effective == 'duty' %}, "duties.py"{% endif %}]