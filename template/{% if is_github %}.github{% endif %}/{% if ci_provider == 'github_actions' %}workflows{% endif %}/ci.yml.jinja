name: CI
{% raw %}
permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

on:
  push:
    branches:
      - main
    tags:
      - '*'
  pull_request:
  # Queue-ready ahead of time: without merge_group a repo that later enables
  # a merge queue would wait on checks that never fire (gh-readonly-queue/*
  # refs match neither push nor pull_request). Until a queue is enabled the
  # event simply never fires. Tag-gated release/pypi jobs stay off because
  # the queue ref is a branch, not a tag.
  merge_group:
{% endraw %}
jobs:
{% if ros2_pkg %}{% if ros2_package_manager == 'pixi' %}
  build-and-test:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Install pixi
        uses: prefix-dev/setup-pixi@f00437f565399d418b0acc85936d12c1fb668347 # v0.10.1
        with:
          environments: default
      - name: Build the workspace
        run: pixi run colcon build --symlink-install --packages-select {{ package_name }}
      - name: Run the ament test suite
        run: |
          pixi run colcon test --packages-select {{ package_name }}
          pixi run colcon test-result --verbose
{% else %}
  industrial_ci:
    strategy:
      fail-fast: false
      matrix:
        env:
          - ROS_DISTRO: {{ ros_distro }}
    env:
      ROS_DISTRO: {{ ros_distro }}
      ROS_REPO: main
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Run industrial_ci
        uses: ros-industrial/industrial_ci@125164b9f1883cdf1858897a7146d1bebf2be5c6 # master
{% raw %}        env:
          ROS_DISTRO: ${{ matrix.env.ROS_DISTRO }}
{% endraw %}{% endif %}{% else %}
  lint:
    uses: ./.github/workflows/_tasks.yml
    with:
      task_runner: {{ task_runner_effective }}
      task: lint{{ ",type-check" if not strictness_minimal else "" }}{{ ",license-check" if not strictness_minimal and license_check_effective else "" }}
{% raw %}
  hygiene:
    uses: ./.github/workflows/_hygiene.yml
{% endraw %}
{% raw %}
  test:
    strategy:
      matrix:
        runs-on: ["ubuntu-latest"] # can add windows-latest, macos-latest
{% endraw %}
        python-version: {{ '["3.11", "3.12", "3.13", "3.14"]' if is_uv else '["3.11"]' }}
{% raw %}
      fail-fast: false
{% endraw %}
{% if web_api and not docker %}
    services:
      postgres:
        image: postgres:17-alpine
        env:
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: test
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
{% endif %}
{% raw %}
    uses: ./.github/workflows/_test.yml
    with:
      runs-on: ${{ matrix.runs-on }}
      python-version: ${{ matrix.python-version }}
{% endraw %}      task_runner: {{ task_runner_effective }}
{% if web_api and not docker %}
      postgres-host: localhost
      postgres-port: 5432
      postgres-user: postgres
      postgres-password: postgres
      postgres-db: test
{% endif %}
{# No `if: always()` on this reusable-call job: GitHub fails the whole
   workflow at startup when a reusable-workflow job with always() runs
   alongside another reusable call (reproduced against the example repo).
   The image simply builds only after tests succeed. #}
{% if docker %}{% raw %}
  container:
    needs: test
    uses: ./.github/workflows/_container.yml
    with:
      publish: ${{ needs.test.result == 'success' }}
{% endraw %}      smoke-command: {{ '--help' if web_api else '--version' }}
    permissions:
      contents: read
      packages: write
{% endif %}{% if docs %}
  docs:
    uses: ./.github/workflows/_docs.yml
    with:
      task_runner: {{ task_runner_effective }}
    permissions:
      contents: write
{% endif %}
{% if micropython_pkg %}
  firmware:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Build frozen firmware
        run: python3 tools/micropython/freeze.py
      - name: Upload firmware
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: firmware-{{ micropython_port }}
          path: dist/
  release:
    needs: [firmware]
    if: github.ref_type == 'tag'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write
    steps:
      - name: Download firmware
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8
        with:
          name: firmware-{{ micropython_port }}
          path: dist
      - uses: softprops/action-gh-release@3d0d9888cb7fd7b750713d6e236d1fcb99157228 # v3.0.2
        with:
          files: dist/**
          generate_release_notes: true
{% elif online_judge %}
  release:
    needs: [test{% if docs %}, docs{% endif %}]
    if: github.ref_type == 'tag'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write
    steps:
      - uses: softprops/action-gh-release@3d0d9888cb7fd7b750713d6e236d1fcb99157228 # v3.0.2
        with:
          generate_release_notes: true
{% elif not micropython_pkg %}
  dist:
    uses: ./.github/workflows/_dist.yml
{% raw %}    with:
      # The exact check for the installed wheel: <pkg> ships a `--version`
      # CLI; web_api's app/ has no CLI entry point, so import it instead.
{% endraw %}      version-command: {{ 'python -m {0} --version'.format(import_pkg) if not web_api else ('python -c ' + '"import {0}; print({0}.__version__)"'.format(import_pkg)) }}
  {% if pypi %}
  pypi:
    needs: [dist, test]
    if: github.ref_type == 'tag'
    uses: ./.github/workflows/_pypi.yml
    permissions:
      # _pypi.yml declares top-level contents: read (artifact download);
      # without this grant the reusable call is rejected at startup and the
      # whole workflow fails with 0 jobs.
      contents: read
      id-token: write
  {% endif %}
  release:
    needs: [dist, test{% if docs %}, docs{% endif %}]
    if: github.ref_type == 'tag'
    uses: ./.github/workflows/_release.yml
    permissions:
      contents: write
{% endif %}
  required-checks-passed:
    name: all required checks passed
    needs: [hygiene, lint, test{% if docker %}, container{% endif %}{% if docs %}, docs{% endif %}{% if micropython_pkg %}, firmware{% elif online_judge %}{% elif not micropython_pkg %}, dist{% endif %}]
{% raw %}
    if: always()
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Check all required jobs passed
        run: |
          failing=$(echo '${{ toJSON(needs) }}' | jq -r '
            to_entries[] |
            select(.value.result != "success" and .value.result != "skipped") |
            "\(.key): \(.value.result)"
          ')
          if [ -n "$failing" ]; then
            echo "$failing"
            echo "Reproduce it locally via the blast-radius table in .github/CONTRIBUTING.md"
            exit 1
          fi
{% endraw -%}{% endif -%}
