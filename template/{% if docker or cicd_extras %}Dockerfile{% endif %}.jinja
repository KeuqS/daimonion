{#- Unconditional by design, and not only a container-publish recipe:
    .devcontainer/devcontainer.json builds this file's `developer` target for
    every project type except ros2 (micropython included: its dev container
    still hosts the CPython dev toolchain -- pyproject, uv.lock, the core
    test). The build/runtime stages below render only when the docker answer
    is on; that question is never asked for micropython, so a micropython
    render ships the developer stage alone. On ros2 the dev container builds
    Dockerfile.ros2 instead, and this file remains the publish image the
    README's Docker section documents (the two Dockerfiles coexist by
    design). -#}
# The devcontainer should use the developer target and run as root with podman
# or docker with user namespaces.
FROM ghcr.io/diamondlightsource/ubuntu-devcontainer:resolute AS developer

# Add any system dependencies for the developer/build environment here
RUN apt-get update -y && apt-get install -y --no-install-recommends \
    graphviz \
    && apt-get dist-clean{% if docker %}
{% if is_uv %}
# The build stage installs the context into the venv
FROM developer AS build

# Change the working directory to the `app` directory
# and copy in the project
WORKDIR /app
COPY . /app
RUN chmod o+wrX .

# Tell uv sync to install python in a known location so we can copy it out later
ENV UV_PYTHON_INSTALL_DIR=/python

# Sync the project without its dev dependencies
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-editable --no-dev --managed-python

# The runtime stage copies the built venv into a runtime container
FROM ubuntu:resolute AS runtime

# Add apt-get system dependencies for runtime here if needed
# RUN apt-get update -y && apt-get install -y --no-install-recommends \
#     some-library \
#     && apt-get dist-clean

# Run as a non-root user (least privilege; the venv is world-readable).
# /app itself is chowned so the app user owns its workdir; bytecode writes
# stay off via PYTHONDONTWRITEBYTECODE (compose also sets it).
RUN useradd --create-home --shell /usr/sbin/nologin appuser

# Copy the python installation from the build stage
COPY --from=build /python /python

# Copy the environment, but not the source code
COPY --from=build /app/.venv /app/.venv
ENV PATH=/app/.venv/bin:$PATH
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
RUN chown appuser:appuser /app
USER appuser
{% else %}
# The build stage installs the context into the pixi environment
FROM developer AS build

# Change the working directory to the `app` directory
# and copy in the project
WORKDIR /app
COPY . /app
RUN chmod o+wrX .

# Install the project without its dev dependencies, using the lockfile
RUN --mount=type=cache,target=/root/.cache/pixi \
    pixi install --locked

# The runtime stage copies the built environment into a runtime container
FROM ubuntu:resolute AS runtime

# Add apt-get system dependencies for runtime here if needed
# RUN apt-get update -y && apt-get install -y --no-install-recommends \
#     some-library \
#     && apt-get dist-clean

# Run as a non-root user (least privilege; the env is world-readable).
# /app itself is chowned so the app user owns its workdir; bytecode writes
# stay off via PYTHONDONTWRITEBYTECODE (compose also sets it).
RUN useradd --create-home --shell /usr/sbin/nologin appuser

# Copy the environment, but not the source code
COPY --from=build /app/.pixi /app/.pixi
ENV PATH=/app/.pixi/envs/default/bin:$PATH
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
RUN chown appuser:appuser /app
USER appuser
{% endif %}

{% if web_api %}
# Run the FastAPI app with uvicorn (the module-level `app` object).
EXPOSE 8000
ENV HOST=0.0.0.0
ENV PORT=8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"
ENTRYPOINT ["uvicorn", "app.main:app"]
CMD ["--host", "0.0.0.0", "--port", "8000"]{% endif %}{% if not web_api %}
# change this entrypoint if it is not the same as the repo
ENTRYPOINT ["{{ repo_name }}"]
CMD ["--version"]{% if mcp_effective %}
# The image also ships the MCP server console script. Serve it over Streamable
# HTTP with (the allowlist is enforced by mcp_server.py for non-local binds):
#   docker run --rm -p 8000:8000 \
#     -e MCP_ALLOWED_HOSTS=localhost,127.0.0.1 \
#     --entrypoint mcp-server-{{ repo_name }} {{ repo_name }} \
#     --transport streamable-http --host 0.0.0.0
# Health check (unauthenticated): GET http://localhost:8000/health
EXPOSE 8000{% endif %}{% if bot_discord_effective %}
# The image also ships the Discord bot console script. It connects to the
# Discord Gateway (no listening port), so it runs with the token from the
# environment; bot_discord.py refuses to start without it:
#   docker run --rm -e DISCORD_BOT_TOKEN \
#     --entrypoint bot-discord-{{ repo_name }} {{ repo_name }}
# Development: append --sync-guild <guild id> to sync the slash commands
# instantly inside that guild instead of globally (up to an hour of caching).{% endif %}{% if bot_slack_effective %}
# The image also ships the Slack bot console script. Socket Mode is an
# outbound WebSocket, so this container listens on no port (nothing to
# EXPOSE) and runs with both tokens from the environment; bot_slack.py
# refuses to start without either:
#   docker run --rm -e SLACK_BOT_TOKEN -e SLACK_APP_TOKEN \
#     --entrypoint bot-slack-{{ repo_name }} {{ repo_name }}{% endif %}{% if bot_line_effective %}
# The image also ships the LINE bot console script. The Messaging API pushes
# events to a webhook, so this one DOES listen: it serves POST /callback
# (signature-verified) on :8000 and runs with both credentials from the
# environment; bot_line.py refuses to start without either:
#   docker run --rm -p 8000:8000 \
#     -e LINE_CHANNEL_SECRET -e LINE_CHANNEL_ACCESS_TOKEN \
#     --entrypoint bot-line-{{ repo_name }} {{ repo_name }}
# Point the channel's webhook URL at https://<your host>/callback.
EXPOSE 8000{% endif %}{% if bot_gmail_effective %}
# The image also ships the Gmail bot console script. It polls the Gmail API
# (an outbound call, like Discord's Gateway), so this container listens on no
# port (nothing to EXPOSE) and runs with both credential paths from the
# environment; bot_gmail.py refuses to start without either. The credentials
# are FILES, so they are mounted read-only into the paths the variables name:
#   docker run --rm \
#     -e GMAIL_CREDENTIALS_JSON=/run/secrets/credentials.json \
#     -e GMAIL_TOKEN_JSON=/run/secrets/token.json \
#     -v ./credentials.json:/run/secrets/credentials.json:ro \
#     -v ./token.json:/run/secrets/token.json:ro \
#     --entrypoint bot-gmail-{{ repo_name }} {{ repo_name }}
# The token file is written only by the very first consent — consent once on
# the host, then mount both files read-only as above.{% endif %}{% endif %}{% endif %}
