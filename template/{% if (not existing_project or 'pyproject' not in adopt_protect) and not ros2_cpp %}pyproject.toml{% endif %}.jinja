{% import "_shared/macros.jinja" as m with context -%}
[build-system]
build-backend = "setuptools.build_meta"
requires = [ "setuptools>=77"{% if not ros2_pkg and not no_pkg %}, "setuptools-scm[toml]>=8"{% endif %} ]

[project]
name = "{{ distribution_name }}"
description = "{{ description }}"
readme = "README.md"
{% if not proprietary -%}
license = "{{ license_effective }}"
{% endif -%}
license-files = [ "LICENSE" ]
authors = [
  # Further authors may be added by duplicating this section
  { name = "{{ author_name }}", email = "{{ author_email }}" }
]
{% if is_poetry %}requires-python = ">=3.11,<4.0"{% else %}requires-python = ">={{ m.python_version() }}"{% endif %}
classifiers = [
    "Development Status :: 3 - Alpha",
    {{ m.classifiers() }}]
{% if ros2_pkg or is_poetry %}{# poetry は setuptools-scm 由来の dynamic version を解釈しないため静的にする #}version = "0.1.0"
{% elif micropython_pkg %}version = "0.1.0"
{% elif online_judge %}version = "0.1.0"
{% else %}dynamic = [ "version" ]
{% endif %}
{# The runtime `dependencies` one-liner is shared (see _shared/pyproject-deps.toml.jinja). #}{% include "_shared/pyproject-deps.toml.jinja" %}
{% if is_gitlab %}urls.Homepage{% else %}urls.GitHub{% endif %} = "{{ repo_url }}"
{% if not web_api and not online_judge and not ros2_pkg and not micropython_pkg %}scripts.{{ repo_name }} = "{{ package_name }}.__main__:main"
{% endif %}{% if mcp_effective %}scripts.mcp-server-{{ repo_name }} = "{{ import_pkg }}.mcp_server:main"
{% endif %}{% if bot_discord_effective %}scripts.bot-discord-{{ repo_name }} = "{{ import_pkg }}.bot_discord:main"
{% endif %}{% if bot_slack_effective %}scripts.bot-slack-{{ repo_name }} = "{{ import_pkg }}.bot_slack:main"
{% endif %}{% if bot_line_effective %}scripts.bot-line-{{ repo_name }} = "{{ import_pkg }}.bot_line:main"
{% endif %}{% if bot_gmail_effective %}scripts.bot-gmail-{{ repo_name }} = "{{ import_pkg }}.bot_gmail:main"
{% endif %}
{# The MicroPython firmware is not a pip-installable Python package: it is
   deployed to the device with mpremote. The [project] table above exists so
   the CPython dev toolchain (ruff/pytest/basedpyright) has a home, but there
   is no setuptools_scm git-tag version and nothing is built or installed. #}
[dependency-groups]{# dev deps: base body shared by every strictness tier + the `rec` guard
   appending the recommended/full-only additions. The docs/sphinx entries are
   captured once and spliced per tier: recommended/full render them before
   pytest (basedpyright leads the group), none/basic after ruff. #}{% set rec = not strictness_minimal %}{% set zensical_deps %}"zensical",
    "mkdocstrings[python]",
    {% endset %}{% set mpremote_deps %}"mpremote",
    {% endset %}{% set sphinx_theme_deps %}"pydata-sphinx-theme>=0.12",
    {% endset %}{% set sphinx_docs_deps %}"myst-parser",
    "sphinx-autobuild",
    "sphinx-copybutton",
    "sphinx-design",
    {% endset %}
dev = [
    {% if rec %}"basedpyright",
    {% if zensical %}{{ zensical_deps }}{% endif %}{% if micropython_pkg %}{{ mpremote_deps }}{% endif %}{% if sphinx %}{{ sphinx_theme_deps }}{% endif %}{% if type_checker=="pyrefly" %}"pyrefly",
    {% endif %}{% if type_checker=="ty" %}"ty",
    {% endif %}    {% endif %}"pytest",
    {% if rec %}"pytest-cov",
    {% endif %}"ruff",{% if mcp_effective or web_api or bot_discord_effective or bot_line_effective %}
    "anyio",{% endif %}{% if web_api %}
    "aiosqlite>=0.20,<1",
    "httpx>=0.27,<1",{% endif %}{% if bot_line_effective and pkg_scaffold %}
    "httpx>=0.27,<1",{% endif %}
    {% if rec %}{% if sphinx %}{{ sphinx_docs_deps }}{% endif %}    {% endif %}{% if not rec %}{% if micropython_pkg %}{{ mpremote_deps }}{% endif %}{% if zensical %}{{ zensical_deps }}{% endif %}{% if sphinx %}{{ sphinx_theme_deps }}{{ sphinx_docs_deps }}{% endif %}{% endif %}{% if great_docs %}"great-docs",
    {% endif %}{% if rec %}    {% endif %}{% if ds_stack %}"ipykernel",
    "nbclient",
    "nbstripout",
    {% endif %}{% if ds_stack %}"pandas",
    "tomli",
    "quartodoc",
    {% endif %}{% if task_runner_effective == 'poe' %}"poethepoet",
    {% elif task_runner_effective == 'invoke' %}"invoke",
    {% elif task_runner_effective == 'duty' %}"duty",
    {% endif %}{% if rec %}{% if cloud_provider == 'aws' %}"boto3-stubs[{{ 'essential' if aws_services == 'essential' else aws_services }}]>=1.34.0",
    {% endif %}"types-mock",
    "vulture",
    "deptry",
    "typos",
    "coverage>=7.15.4,<8",
    "hypothesis>=6.130.0,<7.0",
    "pip-audit>=2.9.0,<3.0",
{% if rec and license_check_effective %}    "pip-licenses>=5.0,<6",
{% endif %}    "pyproject-fmt>=2.27.0,<3.0",
    "pytest-mock>=3.14.0,<4.0",
    "pytest-timeout>=2.4.0,<2.5",
    "pytest-xdist>=3.8.0,<3.9",
    {%- endif %}
]

{% if data_science or kaggle or ctf_effective %}[project.optional-dependencies]
{% endif %}{% if ds_stack %}experiment = [
    # 実験・探索・デバッグ用の依存 (marimo / 可視化 / LLM API)。
    # uv: `uv sync --extra experiment` で追加インストール。
    # pixi: `[tool.pixi.feature.experiment]` として分離。
{{ m.experiment_pep508() }}]
{% endif %}
{# CTF extra body is shared (see _shared/pyproject-ctf-extra.toml.jinja). #}{% include "_shared/pyproject-ctf-extra.toml.jinja" %}

{% if is_pixi and not ros2_pkg %}[tool.pixi.workspace]
channels = ["conda-forge"]
platforms = ["linux-64", "osx-arm64", "osx-64", "win-64"]

[tool.pixi.pypi-dependencies]
{% if micropython_pkg %}{# No editable install: the firmware is deployed with mpremote, not pip. #}
{% elif kaggle %}utils = { path = "src/utils", editable = true }
{% elif web_api %}app = { path = ".", editable = true }
{% else %}{{ package_name }} = { path = ".", editable = true }
{% endif %}

[tool.pixi.environments]
default = { solve-group = "default" }
dev = { features = ["dev"], solve-group = "default" }
{% if ds_stack %}experiment = { features = ["experiment"], solve-group = "default" }
{% endif %}
{% if ds_stack %}[tool.pixi.feature.experiment.pypi-dependencies]
{{ m.experiment_pixi() }}{% endif %}
{# lint/type-check/test/docs tasks live in the chosen task_runner's file
   instead (Taskfile.yml / justfile / Makefile / [tool.poe.tasks] / the
   [tool.pixi.feature.dev.tasks] below) — one definition regardless of
   package_manager. #}
{% if task_runner_effective == 'pixi' %}
{% import "_tasks.jinja" as _t with context %}
[tool.pixi.feature.dev.tasks]
{{ _t.pixi_tasks() }}
{% endif %}

{% endif %}{% if is_uv and use_gpu_effective %}
[[tool.uv.index]]
name = "pytorch-cu126"
url = "https://download.pytorch.org/whl/cu126"
explicit = true

[tool.uv.sources]
torch = { index = "pytorch-cu126" }
torchvision = { index = "pytorch-cu126" }
{% endif %}{% if micropython_pkg %}# Nothing to install: firmware/ is deployed to the device with mpremote.
[tool.setuptools]
packages = []
{% endif %}{% if oj_code %}# Code-submission workspace: answers are single files the user submits
# via oj/atcoder-cli — no pip-installable package is built here.
[tool.setuptools]
packages = []
{% endif %}{% if web_api %}# web_api: the FastAPI app lives in the top-level app/ package
# (no <pkg> library). List app/ explicitly so setuptools does not try
# flat-layout auto-discovery.
[tool.setuptools]
packages = ["app"]
{% elif not micropython_pkg and not online_judge and not use_src_layout and agent_scaffold %}# Flat layout + agent scaffold: prompts/ at the repo root would otherwise be
# picked up by setuptools' automatic flat-layout discovery, so list the real
# packages explicitly.
[tool.setuptools]
packages = ["{{ package_name }}", "{{ package_name }}.tools"]
{% endif %}{% if not no_pkg %}[tool.setuptools_scm]
version_file = "{{ pkg_dir }}/_version.py"
# Publish pipelines generate first and `git init` later: without git
# metadata setuptools_scm aborts every uv sync, so fall back to a
# placeholder until the first commit provides the real version.
fallback_version = "0.0.0"
{% if ros2_pkg %}
# ros2 ament_python: no git-tag versioning; setup.py / package.xml own the version.
{% endif %}
{% endif %}
{# basedpyright body is shared (see _shared/pyproject-basedpyright.toml.jinja). #}{% include "_shared/pyproject-basedpyright.toml.jinja" %}{# pyrefly/ty bodies are shared (see _shared/pyproject-ty-checkers.toml.jinja). #}{% include "_shared/pyproject-ty-checkers.toml.jinja" -%}
{# pytest/coverage/typos/vulture/deptry bodies are shared (see _shared/pyproject-test-coverage.toml.jinja). #}{% include "_shared/pyproject-test-coverage.toml.jinja" %}

{% if task_runner_effective == 'poe' %}
{% import "_tasks.jinja" as _t with context %}
[tool.poe.tasks]
{{ _t.poe_tasks() }}
{% endif %}
[tool.ruff]
src = ["{{ 'firmware' if micropython_pkg else pkg_dir }}", "tests"]
# tools/ は MicroPython の freeze.py（端末依存スクリプト）を、.github/pages は
# 共有の CI ヘルパーを対象外とする。firmware エントリや ament の test/ は
# ファイルごと除外せず、per-file-ignores で必要なルールだけ無効化する。
extend-exclude = ["tools", ".github/pages", "alembic"{% if sphinx %}, "docs"{% endif %}{% if oj_code %}, "**/test"{% endif %}, "*.md", "**/_version.py"]
line-length = {{ 88 if not allow_japanese else 120 }}
# 挙動を変える可能性があるため、自動修正は safe-fix に限定する。
unsafe-fixes = false
{% if not no_pkg %}lint.logger-objects = ["{{ import_pkg }}.logging_setup.get_logger"]
{% endif %}
{# ruff select/ignore/task-tags bodies are shared (see _shared/pyproject-ruff-lint.toml.jinja). #}{% include "_shared/pyproject-ruff-lint.toml.jinja" %}

[tool.ruff.format]
quote-style = "double"
indent-style = "space"
skip-magic-trailing-comma = false
line-ending = "auto"
docstring-code-format = true
{% if not no_pkg %}# logging_setup.py has long logging-library setup calls that format
# differently at line-length 88 vs 120 (allow_japanese), so exclude it from
# formatting (E501 is already ignored for it).
exclude = ["{{ pkg_dir }}/logging_setup.py"]
{% endif %}

[tool.ruff.lint.pydocstyle]
convention = "google"
ignore-decorators = ["typing.overload"]

[tool.ruff.lint.flake8-implicit-str-concat]
# Implicit concatenation across lines is the standard style (ISC002 off);
# ISC003 stays enabled, so explicit `+` concatenation is flagged. This is
# ruff's default; written out so the choice is deliberate and stable.
allow-multiline = true

[tool.ruff.lint.pycodestyle]
ignore-overlong-task-comments = true
max-line-length = {{ 88 if not allow_japanese else 120 }}
max-doc-length = {{ 150 if not allow_japanese else 200 }}

[tool.ruff.lint.isort]
force-single-line = true

[tool.ruff.lint.flake8-tidy-imports]
ban-relative-imports = "parents"
{# Scraping banned-api body is shared (see _shared/pyproject-scraping-banned-api.toml.jinja). #}{% include "_shared/pyproject-scraping-banned-api.toml.jinja" -%}

[tool.ruff.lint.flake8-type-checking]
exempt-modules = ["typing", "typing_extensions"]
quote-annotations = true

[tool.ruff.lint.flake8-import-conventions.extend-aliases]
"dask.dataframe" = "dd"
"xarray" = "xr"
"scipy" = "sp"
"skopt" = "sko"
"skimage" = "ski"
"sklearn" = "sk"
"returns" = "rt"
"pandera" = "pa"

[tool.ruff.lint.flake8-errmsg]
max-string-length = 20

[tool.ruff.lint.mccabe]
max-complexity = 10

[tool.ruff.lint.flake8-annotations]
{%- if strictness == 'full' %}
ignore-fully-untyped = false # full: 全関数に注釈を要求
{%- else %}
ignore-fully-untyped = true # 完全未注釈関数はスキップ（部分注釈の残りは要求）
{%- endif %}
allow-star-arg-any = false
suppress-dummy-args = false
suppress-none-returning = false

[tool.ruff.lint.per-file-ignores]
{%- if task_runner_effective == 'invoke' %}
# invoke タスク定義: コマンド文字列が必然的に長くなるため E501 を豁免
# (ファイルレベル noqa だと行境界次第で RUF100 未使用が発火するため設定側で扱う)
"tasks.py" = ["E501"]
{%- elif task_runner_effective == 'duty' %}
# duty タスク定義: 同上
"duties.py" = ["E501"]
{%- endif %}
# By default, private member access is allowed in tests
# See https://github.com/DiamondLightSource/python-copier-template/issues/154
# Remove this line to forbid private member access in tests
"tests/**/*" = [
    "SLF001", # private member access  CONTEXT: テストは private を直接叩くことがある
    "ANN",
    "S",
    "PT011",  # pytest-raises-too-broad  CONTEXT: ValueError 等の広さがテスト意図に合致
    "PT013",  # pytest-raises-with-multiple-exceptions  CONTEXT: 複数例外はテストで自然
    "PT015",  # pytest-assertion-in-raisable-block  CONTEXT: raises 内の assert は意図的
    "B011",   # assert-false  CONTEXT: 到達しないことを明示する assert はテストで正当
    "PLC0415",# import-outside-top-level  CONTEXT: test_qa.py は関数内 import で stdlib を遅延読込
    "C416",   # manual-list-comprehension  CONTEXT: test_qa.py の walk_packages 収集は append が明確
    "E402",   # module-import-not-at-top-of-file  CONTEXT: test_app.py は
               #   DATABASE_URL を import 前に設定するため env → import の順が必須
    "I001",   # unsorted-imports  CONTEXT: test_app.py の env → import 構造で isort は満足できない
    "E501",   # line-too-long  CONTEXT: test_qa.py の assert メッセージ
    "PLR0912",# too-many-branches  CONTEXT: test_qa.py の依存宣言チェックは複数分岐が自然
]
{# CTF / scraping / analysis lint bodies are shared (see _shared/pyproject-*-lint.toml.jinja). #}{% include "_shared/pyproject-ctf-lint.toml.jinja" %}{% include "_shared/pyproject-scraping-lint.toml.jinja" %}{% include "_shared/pyproject-analysis-lint.toml.jinja" -%}
{% if micropython_pkg %}"firmware/main.py" = [
    "PLC0415", # import-outside-top-level  CONTEXT: machine は unix/windows ポートに
               #   存在しないため、実機（LED 有り）の時だけ遅延 import する。
]
{% endif %}{% if ros2_python %}"test/*" = [
    "INP001", # implicit-namespace-package  CONTEXT: ament の test/ は __init__.py を置かない規約。
    "I001",   # unsorted-imports  CONTEXT: ament 標準テンプレの import 順（ament_* を先に置く）。
    "E501",   # line-too-long  CONTEXT: ament テストの長い assert 行。
]
{% endif %}{% if web_api %}# app/main.py は直交オプション（cors/rate_limit/prometheus）の条件付き
# import を含む app factory のため、isort の自動整列は無効化する。
"{{ pkg_dir }}/main.py" = ["I001"]
{% endif %}{% if not oj_code %}# logging_setup.py の長い呼び出し（structlog の ConsoleRenderer /
# make_filtering_bound_logger、loguru の add() など）は line-length 設定により
# ruff format が折り返しを変えるため、E501 は免除する。
# 日本語 docstring の終端句読点（D415）とシングルトン設定の global（PLW0603）も免除。
"{{ pkg_dir }}/logging_setup.py" = ["E501", "D", "PLW0603", "I001"]
{% endif %}{% if is_poetry %}
[tool.poetry]
# Poetry reads the PEP 621 [project] table and [dependency-groups] above.
# The installable package is listed explicitly: Poetry 2.x auto-discovery
# matches the package directory against the distribution name, so it misses
# a src/ package the questionnaire renamed (distribution vs package_name).
{% if no_pkg %}# No installable package here (firmware / code-submission workspace):
# manage dependencies only, never `poetry build`.
package-mode = false
{% elif web_api %}packages = [{ include = "app" }]
{% elif kaggle %}packages = [{ include = "utils", from = "src" }]
{% elif use_src_layout %}packages = [{ include = "{{ package_name }}", from = "src" }]
{% else %}packages = [{ include = "{{ package_name }}" }]
{% endif %}[tool.poetry.group.dev.dependencies]
{% endif -%}
